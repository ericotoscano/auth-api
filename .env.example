APP_NAME=AuthAPI
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

NODE_ENV=development
LOG_LEVEL=info

# Database connection strings (MongoDB)
# Replace these with your actual database URIs
DEV_DB_URI=mongodb://localhost:27017/auth-api-dev
TEST_DB_URI=mongodb://localhost:27017/auth-api-test
PROD_DB_URI=mongodb://localhost:27017/auth-api-prod

# Email configuration (SMTP)
# Replace with your SMTP provider details (e.g., Mailtrap, SendGrid, Amazon SES)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_user
MAIL_PASSWORD=your_mail_password

# Security tokens secrets and durations
# Replace these with long, random strings (e.g., generated with `openssl rand -base64 32`)
VERIFICATION_TOKEN_SECRET_KEY=your_verification_token_secret
VERIFICATION_TOKEN_DURATION_MINUTES=30

RESET_PASSWORD_TOKEN_SECRET_KEY=your_reset_password_secret
RESET_PASSWORD_TOKEN_DURATION_MINUTES=15

ACCESS_TOKEN_SECRET_KEY=your_access_token_secret
ACCESS_TOKEN_DURATION_MINUTES=15

REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret
REFRESH_TOKEN_DURATION_MINUTES=60
REFRESH_TOKEN_COOKIE_NAME=refreshToken
